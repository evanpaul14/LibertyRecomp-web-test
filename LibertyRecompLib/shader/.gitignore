# Ignore everything by default (large generated shader blobs)
*

# Track the gitignore itself
!.gitignore

# Track shader cache files (game shaders — required to build)
!shader_cache.h
!shader_cache.cpp

# Track postprocess shader cache (postfx shader registry — required to build)
!postprocess_cache.h
!postprocess_cache.cpp

# WGSL translation of the shader cache for the web build's WebGPU renderer
# (tools/webgpu/spirv_to_wgsl.py)
!webgpu_shader_archive.bin
